DATABASE_URL="postgresql://reine:reine@localhost:5433/reine_univers?schema=public"
PORT=3001
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
STORE_LAT=14.7167
STORE_LNG=-17.4677
STORE_ADDRESS="Dakar, Sénégal"
DELIVERY_PREP_SECONDS=480
# GOOGLE_MAPS_API_KEY=your_key_here
JWT_SECRET="change-me-in-production"

# Admin — Google Sign-In / OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADMIN_CALLBACK_URL=http://localhost:3001/auth/admin/google/callback
ADMIN_WEB_URL=http://127.0.0.1:3000
# Emails Google autorisés (séparés par des virgules)
ADMIN_GOOGLE_EMAILS=admin@example.com
# Secours local si Google pas encore configuré
ADMIN_BOOTSTRAP_SECRET=change-me-bootstrap
# Compte admin manuel (créé au 1er démarrage si table vide)
ADMIN_EMAIL=admin@reineunivers.sn
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrateur

# Notifications (email / SMS / push apps)
# console = log seulement (dev). Production: resend|smtp + twilio + expo
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM="RUB <noreply@rubfresh.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# Auth Token (Console → Account → Auth Token → Show) — recommandé
# TWILIO_AUTH_TOKEN=
# Ou API Key Standard (SK…) + secret
# TWILIO_API_KEY=SKxxxxxxxx
# TWILIO_API_SECRET=
# Sénégal: Alphanumeric Sender ID (Orange/Expresso)
TWILIO_FROM=RUBFresh
PUSH_PROVIDER=console
# PUSH_PROVIDER=expo  (React Native / Expo — Play Store & App Store)
PUBLIC_WEB_URL=http://127.0.0.1:3000
